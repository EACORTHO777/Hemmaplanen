PORT=3000
# The frontend that may call this API (CORS)
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
# Secret key: bypasses RLS. Only ever on the server, never in the frontend or git.
SUPABASE_SECRET_KEY=your-secret-key
# Web Push keys: generate with `npx web-push generate-vapid-keys`. The private key is a secret.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=https://your-app.example
