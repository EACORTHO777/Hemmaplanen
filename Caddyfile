# One address for the whole app: the frontend and the API share an origin,
# so the browser needs no CORS for /api.
:80 {
	encode zstd gzip

	# /api/notifications/test -> backend /notifications/test
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# Everything else is the React app; unknown paths fall back to index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
